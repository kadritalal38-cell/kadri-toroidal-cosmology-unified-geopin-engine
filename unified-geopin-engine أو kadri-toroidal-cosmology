    def run_torus_simulation(self):
        """تجسيد مجسم التوروس (Torus) ثلاثي الأبعاد لتفعيل وتوضيح فكرة الانزلاق الطردي"""
        fig = plt.figure(figsize=(12, 10))
        ax = fig.add_subplot(111, projection='3d')
        ax.set_axis_off()
        
        fig.patch.set_facecolor('#020205')
        ax.set_facecolor('#020205')

        # هندسة بناء مجسم التوروس (Parametric Torus Equations)
        R = 12  # نصف قطر التوروس الأكبر
        u_val = np.linspace(0, 2 * np.pi, 45)
        v_val = np.linspace(0, 2 * np.pi, 45)
        u, v = np.meshgrid(u_val, v_val)

        # نقاط فضاء العرض (الكون المشهود مقابل الكون المرآتي المتعاكس)
        galaxy_u = np.array([0, np.pi/2, np.pi, 3*np.pi/2])
        galaxy_v = np.array([np.pi/4, np.pi/2, 3*np.pi/4, np.pi])
        
        plt.legend(loc='upper right', facecolor='#0b0b12', edgecolor='cyan', labelcolor='white')

        def update(frame):
            ax.view_init(elev=22 + 4 * np.sin(frame*0.01), azim=frame * 0.4)
            
            if self.quiver_forward: self.quiver_forward.remove()
            if self.quiver_backward: self.quiver_backward.remove()
            
            cosmic_scale, current_ktc, decoupling = self.calculate_dimensional_decoupling(frame)
            r_dynamic = 3.5 * (1.0 + 0.08 * np.cos(frame * 0.04))  # نصف القطر الأصغر للتوروس (التنفس الهندسي)
            
            # إسقاط مجسم التوروس رياضياً في الفضاء ثلاثي الأبعاد
            X = (R + r_dynamic * np.cos(v)) * np.cos(u) * cosmic_scale
            Y = (R + r_dynamic * np.cos(v)) * np.sin(u) * cosmic_scale
            Z = r_dynamic * np.sin(v)
            
            ax.collections.clear()  # تصفية الذاكرة الفورية لضمان سرعة المحاكاة كالصاروخ
            
            # رسم سطح التوروس الكوني الشفاف لبيان بنية الاندماج والانزلاق
            ax.plot_surface(X, Y, Z, cmap='coolwarm', edgecolor='none', alpha=0.12)
            
            # حساب مواقع الأجرام والضوء داخل مجسم التوروس
            X1 = (R + r_dynamic * np.cos(galaxy_v)) * np.cos(galaxy_u) * cosmic_scale
            Y1 = (R + r_dynamic * np.cos(galaxy_v)) * np.sin(galaxy_u) * cosmic_scale
            Z1 = r_dynamic * np.sin(galaxy_v)
            
            X2 = (R + r_dynamic * np.cos(galaxy_v + np.pi)) * np.cos(galaxy_u + np.pi) * cosmic_scale
            Y2 = (R + r_dynamic * np.cos(galaxy_v + np.pi)) * np.sin(galaxy_u + np.pi) * cosmic_scale
            Z2 = r_dynamic * np.sin(galaxy_v + np.pi)
            
            ax.scatter(X1, Y1, Z1, color='gold', s=150, depthshade=False, label='Observable Space (3D)')
            ax.scatter(X2, Y2, Z2, color='magenta', s=150, depthshade=False, label='Antipodal Space (Mirror)')
            
            # سريان البعد الزمني المنفك عن الأبعاد المكانية بين دفتي التوروس
            time_factor = np.sin(frame * 0.03 * self.temporal_shift) * decoupling
            
            dx1, dy1, dz1 = (X2 - X1) * time_factor * 0.22, (Y2 - Y1) * time_factor * 0.22, (Z2 - Z1) * time_factor * 0.22
            dx2, dy2, dz2 = (X1 - X2) * time_factor * 0.22, (Y1 - Y2) * time_factor * 0.22, (Z1 - Z2) * time_factor * 0.22
            
            # متجهات التدفق الطوبولوجي (الانزلاق المرغم طردياً دون حاجة لأوزان كتلية)
            self.quiver_forward = ax.quiver(X1, Y1, Z1, dx1, dy1, dz1, color='cyan', length=1.1, normalize=False, linewidth=2)
            self.quiver_backward = ax.quiver(X2, Y2, Z2, dx2, dy2, dz2, color='orange', length=1.1, normalize=False, linewidth=2)
            
            # إبراز فكرتك الفلسفية وتوثيق ملكيتك في عنوان الشاشة بوضوح
            ax.set_title(
                f"GeoPin Engine v2.0: Dynamic Torus Framework\n"
                f"Author: {self.author} | {self.copyright}\n"
                f"Photon Decoupling Factor: {decoupling:.3f} | Dynamic KTC: {current_ktc:.2f}\n"
                f"Light and Meteors Slide purely via Geometrical Vectors, NOT Weight Fallacies", 
                color='white', fontsize=9, fontfamily='monospace'
            )
            
            return self.quiver_forward, self.quiver_backward

        ani = FuncAnimation(fig, update, frames=np.arange(0, 360, 2), interval=40, blit=False)
        plt.show()

if __name__ == "__main__":
    engine = UnifiedGeoPinEngine()
